NEXT_PUBLIC_SITE_URL=https://chifaglow.com
NEXT_PUBLIC_API_URL=https://api.chifaglow.com

# Runtime (Easypanel frontend service) — same Postgres as the API
DATABASE_URL=postgres://chifaglow:chifaglow@chifaglow_database:5432/chifaglow?sslmode=disable

NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAPCHAT_PIXEL_ID=

NEXT_PUBLIC_ENABLE_PIXELS=true

# Private admin dashboard (/mydashboard) — runtime secrets, never NEXT_PUBLIC
# Hash: node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 12))"
# Wrap the hash in single quotes so `$` is not interpolated.
# Secret: openssl rand -hex 32
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=
ADMIN_JWT_HOURS=12
